table categoria {
  id INT [pk, increment]
  nombre VARCHAR(255)
  slug VARCHAR(255) 
  descripcion TEXT
  created_at TIMESTAMP
  updated_at TIMESTAMP
}

table productos {
  id INT [pk, increment]
  categoria_id INT [ref: > categoria.id]
  nombre VARCHAR(255)
  slug VARCHAR(255)
  codigo VARCHAR(255) [not null]
  descripcion_corta TEXT
  descripcion_larga TEXT
  precio_compra DECIMAL(10, 2)
  precio_venta DECIMAL(10, 2)
  stock INT
  imagen VARCHAR(255)
  created_at TIMESTAMP
  updated_at TIMESTAMP
}

table imagenes_producto {
  id INT [pk, increment]
  producto_id INT [ref: > productos.id]
  imagen VARCHAR(255)
  created_at TIMESTAMP
  updated_at TIMESTAMP
}
